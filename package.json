{
  "name": "rate-monitor",
  "version": "1.0.0",
  "type": "module",
  "description": "Real-time rate monitoring tool for USDC/USDT <> NGN rates",
  "main": "dist/index.js",
  "keywords": [
    "rate-monitoring",
    "cryptocurrency",
    "effect-ts",
    "typescript"
  ],
  "scripts": {
    "dev": "concurrently \"pnpm run dev:server\" \"pnpm run dev:dashboard\"",
    "dev:server": "tsx watch --env-file=.env src/index.ts",
    "dev:dashboard": "vite",
    "build": "pnpm run clean && pnpm run build:dashboard && pnpm run build:server",
    "build:server": "tsc",
    "build:dashboard": "vite build",
    "start": "tsx dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist dashboard-dist",
    "cleanup:redis": "tsx scripts/cleanup-redis.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "test:whatsapp": "tsx test/infrastructure/whatsapp.test.ts",
    "test:email": "tsx test/infrastructure/email.test.ts",
    "lint": "echo \"Add ESLint configuration\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "@bull-board/api": "^6.13.1",
    "@bull-board/express": "^6.13.1",
    "axios": "^1.12.2",
    "bullmq": "^5.61.0",
    "chart.js": "^4.4.0",
    "effect": "^3.18.4",
    "express": "^5.1.0",
    "ioredis": "^5.8.1",
    "nodemailer": "^7.0.9",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.2",
    "@types/nodemailer": "^7.0.2",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.3.3",
    "vite": "^5.0.10"
  }
}
