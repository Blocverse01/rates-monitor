# ByBit API Configuration
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here

# Blockradar API Configuration
BLOCKRADAR_API_KEY=your_blockradar_api_key_here
BLOCKRADAR_BASE_URL=https://api.blockradar.app

# Redis Configuration
# Prefer REDIS_URL (redis:// or rediss://). Host/port/password/TLS are fallbacks.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# Operator HTTP + Socket.IO basic auth (fail-closed if unset)
OPERATOR_AUTH_USER=
OPERATOR_AUTH_PASSWORD=

# WhatsApp Business API Configuration
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM_EMAIL=alerts@yourdomain.com
SMTP_FROM_NAME="Rate Monitor Alerts"

# Alert Configuration
# Phone numbers in international format (without + or 00)
# Example: 2348012345678 for Nigerian numbers
ALERT_WHATSAPP_NUMBERS=2348012345678,2348087654321

# Email addresses (comma-separated)
ALERT_EMAILS=user1@example.com,user2@example.com

# Alert Thresholds (percentages)
SPREAD_THRESHOLD=3
VOLATILITY_THRESHOLD=2

# Server Configuration
PORT=3000
NODE_ENV=development
